# Database — SQLite for local dev. For production use Postgres:
#   DATABASE_URL="postgresql://user:pass@host:5432/lemonful"  (and set provider = "postgresql" in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the site (used in verification emails)
APP_URL="http://localhost:3000"

# Email. Leave blank in dev: emails are written to the console and the admin Outbox.
RESEND_API_KEY=""
EMAIL_FROM="Lemonful <hello@lemonful.ca>"

# Optional TURN server for video calls behind strict firewalls (JSON array of RTCIceServer)
NEXT_PUBLIC_ICE_SERVERS=""

# Program timezone: weekly availability slots and session times are interpreted in this zone.
TZ="America/Toronto"
