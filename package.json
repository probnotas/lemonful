{
  "name": "lemonful",
  "version": "0.1.0",
  "private": true,
  "description": "Lemonful \u2014 free one-on-one online reading lessons with trained high-school volunteers.",
  "scripts": {
    "dev": "TZ=${TZ:-America/Toronto} tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production TZ=${TZ:-America/Toronto} tsx server.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.15",
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "typescript": "^5.7.2"
  }
}
